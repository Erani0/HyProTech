          Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
          ShowQualityBackground: false;
          ShowQuantity: false;
        }

        Group {
          Anchor: (Width: 6);
        }

        $C.@CheckBox #FilterItem4Check {}

        Group {
          Anchor: (Width: 8);
        }

        Label #FilterItem4Label {
          Style: (
            FontSize: 14,
            TextColor: #c7b59a
          );
          Text: "-";
        }
      }

      Group #FilterRow5 {
        LayoutMode: Left;
        Padding: (Top: 4);
        Visible: false;

        ItemSlot #FilterItem5Icon {
          Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
          ShowQualityBackground: false;
          ShowQuantity: false;
        }

        Group {
          Anchor: (Width: 6);
        }

        $C.@CheckBox #FilterItem5Check {}

        Group {
          Anchor: (Width: 8);
        }

        Label #FilterItem5Label {
          Style: (
            FontSize: 14,
            TextColor: #c7b59a
          );
          Text: "-";
        }
      }

      Group #FilterRow6 {
        LayoutMode: Left;
        Padding: (Top: 4);
        Visible: false;

        ItemSlot #FilterItem6Icon {
          Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
          ShowQualityBackground: false;
          ShowQuantity: false;
        }

        Group {
          Anchor: (Width: 6);
        }

        $C.@CheckBox #FilterItem6Check {}

        Group {
          Anchor: (Width: 8);
        }

        Label #FilterItem6Label {
          Style: (
            FontSize: 14,
            TextColor: #c7b59a
          );
          Text: "-";
        }
      }

      Group #FilterRow7 {
        LayoutMode: Left;
        Padding: (Top: 4);
        Visible: false;

        ItemSlot #FilterItem7Icon {
          Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
          ShowQualityBackground: false;
          ShowQuantity: false;
        }

        Group {
          Anchor: (Width: 6);
        }

        $C.@CheckBox #FilterItem7Check {}

        Group {
          Anchor: (Width: 8);
        }

        Label #FilterItem7Label {
          Style: (
            FontSize: 14,
            TextColor: #c7b59a
          );
          Text: "-";
        }
      }

      Group #FilterRow8 {
        LayoutMode: Left;
        Padding: (Top: 4);
        Visible: false;

        ItemSlot #FilterItem8Icon {
          Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
          ShowQualityBackground: false;
          ShowQuantity: false;
        }

        Group {
          Anchor: (Width: 6);
        }

        $C.@CheckBox #FilterItem8Check {}

        Group {
          Anchor: (Width: 8);
        }

        Label #FilterItem8Label {
          Style: (
            FontSize: 14,
            TextColor: #c7b59a
          );
          Text: "-";
        }
      }

        Group #FilterRow9 {
          LayoutMode: Left;
          Padding: (Top: 4);
          Visible: false;

          ItemSlot #FilterItem9Icon {
            Anchor: (Width: @FilterIconSize, Height: @FilterIconSize, Vertical: 0);
            ShowQualityBackground: false;
            ShowQuantity: false;
          }

          Group {
            Anchor: (Width: 6);
          }

          $C.@CheckBox #FilterItem9Check {}

          Group {
            Anchor: (Width: 8);
          }

          Label #FilterItem9Label {
            Style: (
              FontSize: 14,
              TextColor: #c7b59a
            );
            Text: "-";
          }
        }
      }

      Group #FilterPaging {
        LayoutMode: Left;
        Padding: (Top: 8);

        $C.@SmallSecondaryTextButton #FilterPrev {
          Anchor: (Width: 80);
          Text: "Prev";
        }

        Group {
          Anchor: (Width: 6);
        }

        $C.@SmallSecondaryTextButton #FilterNext {
          Anchor: (Width: 80);
          Text: "Next";
        }

        Group {
          Anchor: (Width: 8);
        }

        Label #FilterPage {
          Style: (
            FontSize: 13,
            TextColor: #96a9be
          );
          Text: "0 / 0";
        }
      }

      Group {
        Anchor: (Height: 8);
      }

      $C.@SmallSecondaryTextButton #FilterClose {
        Anchor: (Width: 120);
        Text: "Close";
      }
    }
  }
}

$C.@BackButton {}

Group #RenamePanel {
  Anchor: (Full: 0);
  Background: #000000(0.55);
  Visible: false;

  Group {
    Anchor: (Full: 0);
    LayoutMode: Center;

    Group #RenamePanelBody {
      Anchor: (Width: 340, Height: 180);
      Background: $C.@InputBoxBackground;
      Padding: (Top: 10, Bottom: 10, Left: 12, Right: 12);
      LayoutMode: Top;

      Label #RenameTitle {
        Style: (
          FontSize: 16,
          RenderBold: true,
          TextColor: #d6cfb2
        );
        Text: "Storage Name";
      }

      CompactTextField #RenameInput {
        Anchor: (Width: 280, Height: 30, Vertical: 0);
        CollapsedWidth: 280;
        ExpandedWidth: 280;
        PlaceholderText: "Enter name...";
        Style: (FontSize: 14);
        PlaceholderStyle: (TextColor: #3d5a85, FontSize: 13);
        Padding: (Horizontal: 10, Left: 10);
      }

      Group {
        Anchor: (Height: 10);
      }

      Group {
        LayoutMode: Left;

        $C.@SmallSecondaryTextButton #RenameSave {
          Anchor: (Width: 120);
          Text: "Save";
        }

        Group {
          Anchor: (Width: 8);
        }

        $C.@SmallSecondaryTextButton #RenameCancel {
          Anchor: (Width: 120);
          Text: "Cancel";
        }
      }
    }
  }
}
