$C = "Common.ui";
@ReqSlotSize = 32;

$C.@PageOverlay {
  $C.@DecoratedContainer {
    Anchor: (Width: 360, Height: 480);

    #Title {
      Group {
        $C.@Title {
          @Text = "Solar Panel";
        }
      }
    }

    #Content {
      LayoutMode: Top;

      Group {
        LayoutMode: Top;
        Padding: (Top: 8, Left: 8, Right: 8);

        Label #SolarTier {
          Style: (
            FontSize: 16,
            RenderBold: true,
            TextColor: #d6cfb2
          );
          Text: "Tier: Basic";
        }

        Label #SolarEnergy {
          Style: (
            FontSize: 13,
            TextColor: #96a9be,
            Wrap: true
          );
          Anchor: (Left: 0, Right: 0);
          Padding: (Top: 4);
          Text: "Energy: 0 / 0";
        }

        Label #SolarGeneration {
          Style: (
            FontSize: 13,
            TextColor: #96a9be
          );
          Padding: (Top: 2);
          Text: "Output: 0 W";
        }

        Group {
          Anchor: (Height: 8);
        }

        Label #SolarNextTier {
          Style: (
            FontSize: 14,
            RenderBold: true,
            TextColor: #c7b59a
          );
          Text: "Next: Reinforced";
        }

        Label #SolarUpgradeStats {
          Style: (
            FontSize: 13,
            TextColor: #96a9be,
            Wrap: true
          );
          Anchor: (Left: 0, Right: 0);
          Padding: (Top: 4);
          Text: "";
        }

        Label #UpgradeReqHeader {
          Style: (
            FontSize: 14,
            RenderBold: true,
            TextColor: #c7b59a
          );
          Padding: (Top: 10);
          Text: "Requirements";
        }

        Group {
          LayoutMode: Top;
          Padding: (Top: 6);

          Group #UpgradeReqRow1 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);

            ItemSlot #UpgradeReqSlot1 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #UpgradeReqName1 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty1 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          Group #UpgradeReqRow2 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);
            Padding: (Top: 4);

            ItemSlot #UpgradeReqSlot2 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #UpgradeReqName2 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty2 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          Group #UpgradeReqRow3 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);
            Padding: (Top: 4);

            ItemSlot #UpgradeReqSlot3 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #UpgradeReqName3 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty3 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          Group #UpgradeReqRow4 {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);
            Padding: (Top: 4);

            ItemSlot #UpgradeReqSlot4 {
              Anchor: (Width: @ReqSlotSize, Height: @ReqSlotSize);
              ShowQualityBackground: false;
              HitTestVisible: false;
            }

            Group {
              Anchor: (Width: 8);
            }

            Label #UpgradeReqName4 {
              FlexWeight: 1;
              Style: (
                FontSize: 13,
                TextColor: #c7b59a
              );
              Text: "";
            }

            Label #UpgradeReqQty4 {
              Anchor: (Width: 70);
              Style: (
                FontSize: 13,
                TextColor: #96a9be,
                HorizontalAlignment: End
              );
              Text: "";
            }
          }

          Label #UpgradeReqEmpty {
            Style: (
              FontSize: 13,
              TextColor: #96a9be
            );
            Padding: (Top: 6);
            Text: "No further upgrades.";
            Visible: false;
          }
        }

        Group {
          Anchor: (Height: 8);
        }

        $C.@TextButton #UpgradeButton {
          Anchor: (Left: 0, Right: 0, Height: 34);
          Text: "Upgrade";
        }
      }
    }
  }
}

$C.@BackButton {}
